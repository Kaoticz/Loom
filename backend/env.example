# Copy to `.env` and edit. Every value here is optional: anything you leave out
# falls back to the default shown. A variable already set in your shell, or
# injected by Docker Compose, takes precedence over this file.

# --- Connections ---------------------------------------------------------
# Defaults suit running Loom directly on your machine. Docker Compose overrides
# all three with its own service names, so you do not need to change them for a
# containerised run.
DATABASE_URL=postgres://loom:loom_password@localhost:5432/loom_db
OLLAMA_BASE_URL=http://localhost:11434
SEARXNG_URL=http://localhost:8080

# --- Repository ----------------------------------------------------------
# The repository Loom works on, as this process sees it.
REPO_PATH=/tmp/repo

# The same directory as the container runtime's host sees it. Only needed when

# --- Models --------------------------------------------------------------
# Must be an embedding model. A chat model such as llama3 will not work.
EMBEDDING_MODEL=snowflake-arctic-embed2

# --- Behaviour -----------------------------------------------------------
# Largest file that will be indexed, in bytes. 0 or negative means no limit.
LOOM_MAX_FILE_SIZE_BYTES=1048576

# How many times a plan or a review may be rejected before Loom stops to ask how
# to proceed, and the hard ceiling on plan-execute-review cycles.
LOOM_MAX_PLAN_RETRIES=10
LOOM_MAX_REVIEW_RETRIES=10
LOOM_MAX_TOTAL_ITERATIONS=20

# Browser origins allowed to call the API, comma separated.
LOOM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Tools ---------------------------------------------------------------
# Path to the ast-grep executable, if it is not on PATH.
AST_GREP_BIN=ast-grep

# Compose-only settings. Copy to `.env` if a default does not suit your machine.
# These configure Docker Compose itself; application settings live in
# backend/.env and frontend/.env, which Compose also reads.

# Group that owns the container socket:  stat -c '%g' /var/run/docker.sock
# DOCKER_GID=999

# Your user, so files written to bind mounts are owned by you.
# UID=1000
# GID=1000

# Container runtime socket. For rootless Podman:
# CONTAINER_SOCKET=/run/user/1000/podman/podman.sock

# Database used by the backend test suite. It must have the pgvector extension.
TEST_DATABASE_URL=postgres://loom:loom_password@localhost:5432/loom_db

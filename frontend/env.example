# Copy to `.env` and edit. Vite only exposes variables prefixed with VITE_ to
# client code. A variable already set in your shell, or injected by Docker
# Compose, takes precedence over this file.

# Where the browser reaches the backend. These are separate because the
# WebSocket uses a different scheme, and because a reverse proxy may put them on
# different paths.
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/api/v1/agent-session

# --- Tests ---------------------------------------------------------------
# A handful of scrolling behaviours can only be checked against a browser that
# has actually laid the page out, because jsdom performs no layout and reports
# every scroll measurement as zero. Those tests skip unless this points at a
# Chromium-family executable, in the same way the backend's suites skip unless
# TEST_DATABASE_URL and AST_GREP_BIN are set. Everything else runs without it.
#
# The driver, playwright-core, is an optional dependency: it downloads no
# browsers of its own, so the executable below is whichever one you already
# have. Not set by default.
# LOOM_BROWSER_BIN=/usr/bin/chromium

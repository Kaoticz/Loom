# Copy to `.env` and edit. Vite only exposes variables prefixed with VITE_ to
# client code. A variable already set in your shell, or injected by Docker
# Compose, takes precedence over this file.

# Where the browser reaches the backend. These are separate because the
# WebSocket uses a different scheme, and because a reverse proxy may put them on
# different paths.
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/api/v1/agent-session
